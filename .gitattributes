* text=auto eol=lf

# Markdown uses two trailing spaces for deliberate hard line breaks, and this
# repository preserves several byte-frozen source receipts verbatim.
*.md whitespace=-trailing-space,-blank-at-eof
*.py whitespace=-blank-at-eof
*.sh whitespace=-blank-at-eof
.gitattributes whitespace=-blank-at-eof

*.pdf binary
*.zip binary
